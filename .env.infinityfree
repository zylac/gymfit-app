# ═══════════════════════════════════════════
# .env PRODUCTION UNTUK INFINITYFREE
# ═══════════════════════════════════════════
#
# CARA PAKAI:
# 1. Copy file ini ke .env
# 2. Isi DB_HOST, DB_DATABASE, DB_USERNAME, DB_PASSWORD
# 3. Upload .env ke /htdocs/
# ═══════════════════════════════════════════

APP_NAME=GymFit
APP_ENV=production
APP_KEY=base64:UPPOEk3plvVhT3MgYiFCZhbD1RyVHvk+TMOpzCjBO5Y=
APP_DEBUG=false
APP_URL=https://gymfit.epizy.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database InfinityFree (ISI SESUAI DATABASE YANG DIBUAT) ---
DB_CONNECTION=mysql
DB_HOST=sqlXXX.infinityfree.com    # GANTI - lihat di control panel
DB_PORT=3306
DB_DATABASE=epiz_XXXXX_gymfit      # GANTI - lihat di control panel
DB_USERNAME=epiz_XXXXX             # GANTI - lihat di control panel
DB_PASSWORD=password_kamu           # GANTI - password database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@gymfit.app"
MAIL_FROM_NAME="${APP_NAME}"
