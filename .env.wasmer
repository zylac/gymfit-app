APP_NAME=GymFit
APP_ENV=production
APP_KEY=base64:LOyiosKumzwgOLk4YHYZQYGBrFp+ZmfRs9oJeRk0SsI=
APP_DEBUG=false
APP_URL=https://gymfit.wasmer.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database: akan diisi setelah create database di Wasmer ---
DB_CONNECTION=mysql
DB_HOST=wasmer-db-host
DB_PORT=3306
DB_DATABASE=gymfit
DB_USERNAME=gymfit
DB_PASSWORD=your-db-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@gymfit.app"
MAIL_FROM_NAME="${APP_NAME}"
