# ⚠️ FILE INI ADALAH TEMPLATE! ⚠️
# Jangan upload .env ini ke server.
# Copy nilai-nilai di bawah ini ke Wasmer Dashboard > Secrets setelah deploy!
#
# SETELAH DEPLOY, generate ulang APP_KEY:
# php artisan key:generate --show
# lalu update di Wasmer Secrets!

APP_NAME=GymFit
APP_ENV=production
APP_KEY=base64:GANTI_SETELAH_DEPLOY_PAKAI_PHP_ARTISAN_KEY:GENERATE
APP_DEBUG=false
APP_URL=https://gymfit.wasmer.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database: GANTI setelah create database di Wasmer Dashboard ---
DB_CONNECTION=mysql
DB_HOST=isi-dari-wasmer-dashboard
DB_PORT=3306
DB_DATABASE=gymfit
DB_USERNAME=gymfit_user
DB_PASSWORD=isi-password-dari-wasmer

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

PHP_CLI_SERVER_WORKERS=4

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@gymfit.app"
MAIL_FROM_NAME="${APP_NAME}"
